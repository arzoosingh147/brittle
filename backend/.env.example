# Application
PROJECT_NAME="Brittle PR Reviewer"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-development-key-change-in-production-min-32-bytes"

# Database & Vector Store
DATABASE_URL="postgresql+asyncpg://brittle:brittle_secret@localhost:5433/brittle_db"
DATABASE_URL_SYNC="postgresql://brittle:brittle_secret@localhost:5433/brittle_db"
VECTOR_DIMENSION=768

# Redis & Queues
REDIS_URL="redis://localhost:6379/0"
USE_CELERY=false

# GitHub App Integration
GITHUB_APP_ID="123456"
GITHUB_APP_PRIVATE_KEY_PATH=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET="development-webhook-secret"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# AI / LLM Models (Google Gemini & Fallback Groq)
GEMINI_API_KEY=""
GROQ_API_KEY=""
DEFAULT_REVIEW_MODEL="gemini-2.5-pro"
FAST_SUMMARY_MODEL="gemini-2.5-flash"
EMBEDDING_MODEL="gemini-embedding-001"
FALLBACK_LLM_PROVIDER="groq"
FALLBACK_MODEL="qwen-2.5-coder-32b"

# Limits & Token Budgeting
MAX_DIFF_FILES=30
MAX_DIFF_LINES_PER_FILE=1000
TOP_K_CODE_CONTEXT=6
MAX_TOKENS_BUDGET=12000
